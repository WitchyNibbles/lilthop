{
  "extends": ["./.grimoire/tsconfig.base.json"],
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsc-node"
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.mjs",
    "tools",
    ".grimoire/eslint.config.mjs"
  ]
}
